# WinsAlt NetBIOS Name Server - systemd unit (installed by install.sh as /etc/systemd/system/winsalt.service)
#
# Runs as root: the dashboard's firewall buttons call firewall-cmd / ufw, which need root, and
# UDP 137 is a privileged port. What root may touch is narrowed by the sandboxing below.
[Unit]
Description=WinsAlt NetBIOS Name Server (WINS replacement)
After=network-online.target
Wants=network-online.target
# Samba's nmbd holds UDP 137 - the two cannot run together.
Conflicts=nmbd.service

[Service]
Type=notify
ExecStart=/opt/winsalt/winsalt
WorkingDirectory=/opt/winsalt
# Registrations, static mappings, partners, replication, auth.json and the dashboard's settings.json.
Environment=Wins__DataDirectory=/var/lib/winsalt
StateDirectory=winsalt
StateDirectoryMode=0750

# The dashboard's "Restart service" button exits with code 75: counted as a clean stop, but always
# followed by a start. Any real failure restarts the service too.
Restart=on-failure
SuccessExitStatus=75
RestartForceExitStatus=75
RestartSec=2
TimeoutStopSec=45

# ---- sandboxing ----
ProtectSystem=full
# ufw keeps its rules here (firewalld is driven over D-Bus and needs no file access)
ReadWritePaths=-/etc/ufw
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
