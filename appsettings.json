{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },

  "Wins": {
    "ListenAddress": "0.0.0.0",
    "Port": 137,
    "Workers": 0,
    "QueueCapacity": 4096,
    "AnswerBroadcasts": false,
    "MinTtlSeconds": 21600,
    "MaxTtlSeconds": 518400,
    "SweepIntervalSeconds": 30,
    "PersistIntervalSeconds": 30,
    "ConflictPolicy": "Challenge",
    "QueryLogCapacity": 1000,
    "ReplicationPort": 8138,
    "RegisterSelf": true,
    "SelfName": "",
    "SelfSuffixes": [ "00", "20" ],
    "SelfGroup": "",
    "Security": {
      "RegistrationMode": "Dynamic",
      "AllowedSubnets": [],
      "RequireAddressMatchesSource": false,
      "BlockedNames": [ "WPAD", "ISATAP" ],
      "MaxDynamicNames": 100000,
      "MaxNamesPerAddress": 64,
      "RateLimitPerSecond": 100,
      "RateLimitBurst": 300,
      "MaxConcurrentChallenges": 64,
      "AllowMultihomedMerge": true
    },
    "Dns": {
      "Enabled": true,
      "Servers": [],
      "Suffix": "",
      "TimeoutMs": 2000,
      "CacheSeconds": 300,
      "NegativeCacheSeconds": 60
    }
  },
  "Dashboard": {
    "AdminToken": "",
    "RequireSignInToView": true,
    "AllowedHosts": []
  },
  "Kestrel": {
    "Endpoints": {
      "Management": {
        "Url": "http://0.0.0.0:8137"
      }
    }
  }
}
